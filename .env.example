# Default: fully local synthetic payment tests. No bank, UPI ID or money transfer.
YOUPI_MODE=mock

# Optional: connect an independently hosted YouPI instance for controlled evaluation.
# Do not place any of these credentials in dist/ or browser storage.
# YOUPI_MODE=external
# YOUPI_API_URL=http://127.0.0.1:6100
# YOUPI_CHECKOUT_ORIGIN=http://127.0.0.1:7000
# YOUPI_MERCHANT_ID=
# YOUPI_MERCHANT_API_KEY=
# YOUPI_WEBHOOK_SECRET=
# PUBLIC_STORE_URL=http://127.0.0.1:4173
